# Copia este fichero como .env y ajusta los valores.

# Clave para firmar los tokens de sesión. OBLIGATORIO cambiarla en producción:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave

# SQLite por defecto. Para PostgreSQL (por ejemplo, el de Supabase por su pooler, que usa IPv4):
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost/ociosingluten

# Fotos en Supabase Storage en vez de en la carpeta backend/uploads/ (para servidores sin disco
# persistente, como el plan gratuito de Render). La clave es la secreta: Settings > API Keys.
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_BUCKET=fotos

# Desactiva la geolocalización de direcciones (útil sin conexión a internet)
# GEOCODIFICAR=false

# Dirección pública de la web, para los enlaces de los correos, las vistas previas al compartir
# y el sitemap. Obligatoria en producción.
# URL_PUBLICA=https://ociosingluten.es

# Correo saliente (recuperar la contraseña). Sin SMTP_HOST, los correos se guardan como
# ficheros .eml en backend/correos/ y se pueden abrir con cualquier programa de correo.
# SMTP_HOST=smtp.ejemplo.es
# SMTP_PUERTO=587
# SMTP_USUARIO=usuario
# SMTP_PASSWORD=clave
# CORREO_REMITENTE=Ocio Sin Gluten <no-responder@ociosingluten.es>
