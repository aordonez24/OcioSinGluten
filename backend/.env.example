# Copia este fichero como .env y ajusta los valores.

# Clave para firmar los tokens de sesión. OBLIGATORIO cambiarla en producción:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave

# SQLite por defecto. Para PostgreSQL (pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost/ociosingluten

# Desactiva la geolocalización de direcciones (útil sin conexión a internet)
# GEOCODIFICAR=false

# Dirección pública de la web, para los enlaces de los correos. Obligatoria en producción.
# URL_PUBLICA=https://ociosingluten.es

# Correo saliente (recuperar la contraseña). Sin SMTP_HOST, los correos se guardan como
# ficheros .eml en backend/correos/ y se pueden abrir con cualquier programa de correo.
# SMTP_HOST=smtp.ejemplo.es
# SMTP_PUERTO=587
# SMTP_USUARIO=usuario
# SMTP_PASSWORD=clave
# CORREO_REMITENTE=Ocio Sin Gluten <no-responder@ociosingluten.es>
