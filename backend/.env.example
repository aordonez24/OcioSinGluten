# Copia este fichero como .env y ajusta los valores.

# Clave para firmar los tokens de sesión. OBLIGATORIO cambiarla en producción:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave

# SQLite por defecto. Para PostgreSQL (pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost/ociosingluten

# Desactiva la geolocalización de direcciones (útil sin conexión a internet)
# GEOCODIFICAR=false
